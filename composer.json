{
    "name": "mf1dd/object-builder",
    "description": "For automatically creating objects. Objects are created with random values",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "nikic/php-parser": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "MF1DD\\Domain\\": "src/Domain/",
            "MF1DD\\Application\\": "src/Application/",
            "MF1DD\\Infrastructure\\": "src/Infrastructure/",
            "MF1DD\\UserInterface\\": "src/UserInterface/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MF1DD\\Tests\\Unit\\": "tests/Unit/",
            "MF1DD\\Tests\\Integration\\": "tests/Integration/",
            "MF1DD\\Tests\\Fixture\\": "tests/Fixture/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^10.4.2",
        "phpstan/phpstan": "^2.1",
        "symplify/easy-coding-standard": "^12.1",
        "infection/infection": "^0.30",
        "roave/security-advisories": "dev-latest",
        "rector/rector": "^2.1",
        "vimeo/psalm": "^6.13",
        "deptrac/deptrac": "^3.0"
    },
    "authors": [
        {
            "name": "Silas Hermann",
            "email": "Timelesstron@playgx.de"
        }
    ],
    "config": {
        "allow-plugins": {
            "infection/extension-installer": true
        }
    }
}
