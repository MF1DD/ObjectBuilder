{
    "$schema": "vendor/infection/infection/resources/schema.json",
    "source": {
        "directories": [
            "src"
        ],
        "excludes": [
            "Dto",
            "Exceptions",
            "ClassBuilder/ClassBuilder.php",
            "ClassBuilder/Interface/FileContentHandler.php"
        ]
    },
    "mutators": {
        "@default": true,
        "@function_signature": false
    },
    "logs": {
        "text": "infection-report.txt",
        "html": "infection-report.html",
        "summary": "infection-summary.txt"
    },
    "phpUnit": {
        "configDir": "."
    },
    "timeout": 30
}
